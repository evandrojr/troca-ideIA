# Endereço do servidor (host:porta). Use 0.0.0.0 para expor na rede e as IAs acessarem.
ADDR=:7676

# ---- Configuração da IA (API OpenAI-compatible) ----
# Deixe AI_API_KEY vazio para rodar no MODO LOCAL (sem respostas reais de IA).

# Chave de API. Aceita OpenAI, OpenRouter, Groq, Azure OpenAI (com base_url), etc.
AI_API_KEY=

# Raiz da API. OpenAI: https://api.openai.com/v1  |  OpenRouter: https://openrouter.ai/api/v1  |  Groq: https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1

# Modelo. OpenAI: gpt-4o-mini  |  OpenRouter: openai/gpt-4o-mini  |  Groq: llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini

# Prompt de sistema (comportamento da IdeIA). Opcional.
AI_SYSTEM="Você é a IdeIA, uma parceira de desenvolvimento de software que colabora em uma sala de chat com humanos. Responda em português do Brasil, de forma concisa e prática."
